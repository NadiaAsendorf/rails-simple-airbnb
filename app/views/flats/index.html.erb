<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h2 mb-0">All flats</h1>
  <%= link_to "+ Add a flat", new_flat_path, class: "btn btn-danger" %>
</div>

<div class="row g-4">
  <% @flats.each do |flat| %>
    <div class="col-12 col-md-6 col-lg-4">
      <div class="card h-100 shadow-sm border-0">
        <div class="card-body">
          <span class="badge text-bg-secondary mb-2"><%= flat.price_per_night %> Euro</span>
          <h2 class="h5 card-title">
            <%= link_to flat.name, flat_path(flat), class: "stretched-link text-decoration-none text-dark" %>
          </h2>
          <p class="card-text text-muted mb-0">📍 <%= flat.address %></p>
        </div>
      </div>
    </div>
  <% end %>
</div>
